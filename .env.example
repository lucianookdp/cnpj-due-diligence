DATABASE_URL=postgresql+psycopg://cnpj:cnpj@localhost:5432/cnpj_due_diligence

# Used by docker-compose.yml directly (Postgres container + backend/worker's
# DATABASE_URL). No default for the password on purpose — compose refuses to
# start without it set here. Not used outside Docker Compose.
POSTGRES_USER=cnpj
POSTGRES_PASSWORD=
POSTGRES_DB=cnpj_due_diligence

# Baked into the frontend at build time (Vite inlines VITE_* vars) — set this
# to the real public API URL before `docker compose build` in any non-local
# deployment, or the built frontend will keep trying to reach localhost.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# development | production — see SECRET_KEY below. Non-dev deploys must set
# this to "production" so the app refuses to boot with the default secret.
ENVIRONMENT=development

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

MINHA_RECEITA_BASE_URL=https://minhareceita.org
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
# Undocumented companion service to Minha Receita (same open dataset) that
# supports the partner -> other-companies reverse lookup the graph needs.
GRAFO_MINHA_RECEITA_BASE_URL=https://grafo.minhareceita.org
PROVIDER_TIMEOUT_SECONDS=10

CACHE_TTL_HOURS=720

GRAPH_MAX_DEPTH=2
GRAPH_MAX_NODES_PER_LEVEL=50
GRAPH_MAX_PARTNER_LOOKUPS_PER_COMPANY=20
SHARED_ADDRESS_THRESHOLD=5

# Free key from https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=
PORTAL_TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br
# No JSON/CSV alternative exists for this one — it's PDF-only.
LISTA_SUJA_PDF_URL=https://www.gov.br/trabalho-e-emprego/pt-br/assuntos/inspecao-do-trabalho/areas-de-atuacao/cadastro_de_empregadores.pdf
RESTRICTIVE_LIST_MAX_PAGES=10000
# Delay between paginated CGU API requests during ingestion, to avoid tripping
# their own rate limiting or getting our IP flagged on a full historical load.
RESTRICTIVE_LIST_PAGE_DELAY_SECONDS=0.2

# Enables POST /api/v1/internal/worker/run-once, which lets an external cron
# (e.g. GitHub Actions) trigger a worker pass without a paid background
# worker service. Empty disables the endpoint entirely. Generate a real
# value for any non-dev deployment: openssl rand -hex 32
WORKER_TRIGGER_SECRET=

# Generate a real secret for any non-dev deployment: openssl rand -hex 32
# The app refuses to start with this default value when ENVIRONMENT=production.
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

REPROCESS_INTERVAL_HOURS=24
RESTRICTIVE_LIST_INGEST_INTERVAL_HOURS=24
WORKER_POLL_INTERVAL_SECONDS=60
STALE_JOB_MINUTES=30
